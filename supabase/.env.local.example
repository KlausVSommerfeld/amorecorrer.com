# Supabase Edge Functions - Variáveis de Ambiente Local
# Arquivo de exemplo - COPIE ESTE ARQUIVO PARA .env.local E PREENCHA COM SEUS VALORES
# Este arquivo é carregado automaticamente pelo Supabase CLI ao servir as funções localmente

# ====== Stripe ======
# Obtenha sua chave em: https://dashboard.stripe.com/apikeys
# Procure por "Secret key" (começa com sk_test_ em desenvolvimento)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE

# ====== Supabase ======
# URLs e chaves do projeto local (fornecidas pelo `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
# Copie o valor de "Secret key:" do output de `supabase start`
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY_HERE

# ====== Pipeline de despacho (FastAPI — substitui n8n) ======
# URL pública HTTPS do pipeline (hooks/dispatch). Com Supabase remoto, localhost não resolve.
# DISPATCH_PIPELINE_URL=https://SUBDOMINIO.tunnel.example/hooks/dispatch
# Mesmo valor em PIPELINE_HMAC_SECRET (server/), DISPATCH_PIPELINE_HMAC_SECRET aqui na Edge:
# DISPATCH_PIPELINE_HMAC_SECRET=your-shared-hmac-secret
#
# Opcional — retrocompatível:
# N8N_WEBHOOK_URL=...
# N8N_HMAC_SECRET=...

# ====== CORS ======
# Origens permitidas para as Edge Functions (separadas por vírgula)
# Adicione localhost:5173 se está desenvolvendo localmente
# Adicione localhost:8080 ou 127.0.0.1:8080 para desenvolvimento com Vite
ORIGIN_WHITELIST=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
