# ============================================================================
# .env.local — perfil LOCAL (Supabase em Docker)
# Sobrepõe o `.env`. Enquanto existir, este é o perfil ativo.
# ----------------------------------------------------------------------------
# PRECEDÊNCIA — vale igual para os quatro runtimes (Vite, Edge, Express,
# pipeline): carrega-se `.env` e depois `.env.local`, e QUEM VEM DEPOIS GANHA.
# Ou seja, enquanto `.env.local` existir, o perfil ativo é o LOCAL.
# Para testar contra a Supabase da web, renomeie `.env.local` (ex.: para
# `.env.local.off`) — não basta editar o `.env`.
#
# Modelo versionado. Copie para o arquivo real e preencha. Copie para `.env.local` e preencha.
# ============================================================================

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
VITE_ENV=local
VITE_PUBLIC_BASE_URL=http://localhost:8080
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGci...COLE_A_ANON_KEY_AQUI
VITE_CREATE_CHECKOUT_URL=http://127.0.0.1:54321/functions/v1/create-checkout-session
VITE_FORM_SUBMIT_URL=http://127.0.0.1:54321/functions/v1/form-submit
VITE_STRIPE_WEBHOOK_URL=http://127.0.0.1:54321/functions/v1/stripe-webhook
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_WHATSAPP_URL=https://wa.me/5521997381497
VITE_CONTACT_EMAIL=amorecorrer@gmail.com

# ---------------------------------------------------------------------------
# Supabase local — chaves-demo padrão de toda instalação (não são segredo)
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...COLE_A_SERVICE_ROLE_AQUI

# ---------------------------------------------------------------------------
# Edge Functions
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8080
ORIGIN_WHITELIST=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_FULL=price_...
# A Edge roda DENTRO de container: `127.0.0.1` ali é o próprio container,
# não a sua máquina. Para alcançar o pipeline local, use host.docker.internal.
DISPATCH_PIPELINE_URL=http://host.docker.internal:8000/hooks/dispatch
DISPATCH_PIPELINE_HMAC_SECRET=gere_com__openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Express (API interna)
# ---------------------------------------------------------------------------
PORT=3001
PIPELINE_HMAC_SECRET=gere_com__openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Pipeline (FastAPI)
# ---------------------------------------------------------------------------
EXPRESS_INTERNAL_URL=http://127.0.0.1:3001
PIPELINE_ENV=development
STORAGE_BUCKET=generated-recursos
# Vazios de propósito: sem IA e sem e-mail no perfil local. O worker devolve
# um rascunho de placeholder e grava `email_skipped` em vez de fingir envio.
DEEPSEEK_API_KEY=
SMTP_HOST=
