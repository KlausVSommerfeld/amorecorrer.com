# ============================================================================
# .env.production — variáveis do LANÇAMENTO OFICIAL
# ----------------------------------------------------------------------------
# Não é carregado no desenvolvimento do dia a dia. O Vite só o lê em
# `vite build --mode production`; Edge, Express e pipeline recebem estes
# valores pelo painel de cada serviço (secrets do Supabase, env do host).
#
# Tudo marcado com SUBSTITUA_ ainda precisa do valor de produção. Hoje o
# produto e os preços existem só no sandbox do Stripe — ver a pendência 2
# do PROGRESSO.md.
#
# Modelo versionado. Copie para o arquivo real e preencha. Copie para `.env.production` e preencha.
# ============================================================================

# ---------------------------------------------------------------------------
# Frontend (Vite) — só VITE_* chega ao bundle do navegador
# ---------------------------------------------------------------------------
VITE_ENV=production
VITE_PUBLIC_BASE_URL=https://www.amorecorrer.com
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...COLE_A_ANON_KEY_AQUI
VITE_CREATE_CHECKOUT_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/create-checkout-session
VITE_FORM_SUBMIT_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/form-submit
VITE_STRIPE_WEBHOOK_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/stripe-webhook
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_WHATSAPP_URL=https://wa.me/5521997381497
VITE_CONTACT_EMAIL=amorecorrer@gmail.com

# ---------------------------------------------------------------------------
# Supabase — projeto de produção
# ---------------------------------------------------------------------------
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...COLE_A_SERVICE_ROLE_AQUI

# ---------------------------------------------------------------------------
# Edge Functions — chaves LIVE do Stripe
# ---------------------------------------------------------------------------
FRONTEND_URL=https://www.amorecorrer.com
ORIGIN_WHITELIST=https://www.amorecorrer.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_FULL=price_...
# Endereço estável do pipeline — nada de túnel efêmero em produção.
DISPATCH_PIPELINE_URL=SUBSTITUA_URL_PUBLICA_DO_PIPELINE/hooks/dispatch
# Mesmo segredo que PIPELINE_HMAC_SECRET abaixo. Gere com: openssl rand -hex 32
DISPATCH_PIPELINE_HMAC_SECRET=gere_com__openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Express (API interna)
# ---------------------------------------------------------------------------
PORT=3001
PIPELINE_HMAC_SECRET=gere_com__openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Pipeline (FastAPI)
# ---------------------------------------------------------------------------
EXPRESS_INTERNAL_URL=SUBSTITUA_URL_INTERNA_DO_EXPRESS
PIPELINE_LISTEN_HOST=0.0.0.0
PIPELINE_LISTEN_PORT=8000
# production torna o SMTP OBRIGATÓRIO: sem ele o worker levanta erro.
PIPELINE_ENV=production
STORAGE_BUCKET=generated-recursos
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_...
MAIL_FROM=Amo Recorrer <nao-responda@seudominio.com>
MAIL_SUBJECT=Seu recurso de multa - Amo Recorrer
