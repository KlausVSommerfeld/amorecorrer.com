# Shared HMAC secret (same as EDGE DISPATCH_PIPELINE_HMAC_SECRET / N8N_HMAC_SECRET and server PIPELINE_HMAC_SECRET)
PIPELINE_HMAC_SECRET=your-long-random-shared-secret

# Express internal API (where /internal/cases, /generated-documents, /finish live)
EXPRESS_INTERNAL_URL=http://127.0.0.1:3001

# Supabase Storage (PDF upload — private bucket; create in Dashboard + policies for service role)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STORAGE_BUCKET=generated-recursos

# Listen (passed to uvicorn when you run manually)
PIPELINE_LISTEN_HOST=0.0.0.0
PIPELINE_LISTEN_PORT=8000

# DeepSeek OpenAI-compatible
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Runtime mode: production requires SMTP_HOST and MAIL_FROM; development/test may skip email.
PIPELINE_ENV=development

# SMTP via Resend. Use your Resend API key as SMTP_PASSWORD.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_resend_api_key
MAIL_FROM=Amo Recorrer <no-reply@seudominio.com>
MAIL_SUBJECT=Seu recurso de multa - Amo Recorrer
SMTP_TEST_TO=seu@email.com
