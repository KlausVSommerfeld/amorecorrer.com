# ============================================================================
# .env — perfil WEB (Supabase na nuvem)
# Base. Usado quando `.env.local` NÃO existe.
# ----------------------------------------------------------------------------
# PRECEDÊNCIA — vale igual para os quatro runtimes (Vite, Edge, Express,
# pipeline): carrega-se `.env` e depois `.env.local`, e QUEM VEM DEPOIS GANHA.
# Ou seja, enquanto `.env.local` existir, o perfil ativo é o LOCAL.
# Para testar contra a Supabase da web, renomeie `.env.local` (ex.: para
# `.env.local.off`) — não basta editar o `.env`.
#
# Modelo versionado. Copie para o arquivo real e preencha. Copie para `.env` e preencha.
# ============================================================================

# ---------------------------------------------------------------------------
# Frontend (Vite) — só VITE_* chega ao bundle do navegador
# ---------------------------------------------------------------------------
VITE_ENV=web
VITE_PUBLIC_BASE_URL=https://www.amorecorrer.com
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...COLE_A_ANON_KEY_AQUI
VITE_CREATE_CHECKOUT_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/create-checkout-session
VITE_FORM_SUBMIT_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/form-submit
VITE_STRIPE_WEBHOOK_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/stripe-webhook
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_WHATSAPP_URL=https://wa.me/5521997381497
VITE_CONTACT_EMAIL=amorecorrer@gmail.com

# ---------------------------------------------------------------------------
# Supabase — projeto da nuvem (Edge injeta as suas; Express/pipeline leem daqui)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...COLE_A_SERVICE_ROLE_AQUI

# ---------------------------------------------------------------------------
# Edge Functions
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8080
ORIGIN_WHITELIST=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_FULL=price_...
DISPATCH_PIPELINE_URL=https://andy-connecting-arc-art.trycloudflare.com/hooks/dispatch
# Precisa ser IGUAL a PIPELINE_HMAC_SECRET abaixo — é o mesmo segredo com
# dois nomes, um por serviço. Divergiram uma vez e o dispatch morreu em 401.
DISPATCH_PIPELINE_HMAC_SECRET=gere_com__openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Express (API interna)
# ---------------------------------------------------------------------------
PORT=3001
PIPELINE_HMAC_SECRET=gere_com__openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Pipeline (FastAPI)
# ---------------------------------------------------------------------------
EXPRESS_INTERNAL_URL=http://127.0.0.1:3001
PIPELINE_LISTEN_HOST=0.0.0.0
PIPELINE_LISTEN_PORT=8000
PIPELINE_ENV=development
STORAGE_BUCKET=generated-recursos
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_...
MAIL_FROM=Amo Recorrer <nao-responda@seudominio.com>
MAIL_SUBJECT=Seu recurso de multa - Amo Recorrer
SMTP_TEST_TO=voce@exemplo.com
