# === AMBIENTE / BASE ===
VITE_ENV=dev                                 # Nome do ambiente (usado para logs ou branch-based behavior)
VITE_PUBLIC_BASE_URL=http://localhost:5173   # Base URL pública do frontend, usada em redirecionamentos se necessário

# === SUPABASE ===
VITE_SUPABASE_URL=https://xxxx.supabase.co               # URL do projeto Supabase
VITE_SUPABASE_ANON_KEY=eyJ...                            # Chave pública ANON (leitura/escrita limitada)
VITE_SUPABASE_PROJECT_ID=xxxx                            # Apenas informativo (não usada no código)

# === EDGE FUNCTIONS ===
VITE_CREATE_CHECKOUT_URL=https://xxxx.supabase.co/functions/v1/create-checkout-session
# → Usada para iniciar o checkout Stripe com um case_id dinâmico
VITE_FORM_SUBMIT_URL=https://xxxx.supabase.co/functions/v1/form-submit
# → Usada para enviar o formulário preenchido para a Edge Function (e parear com pagamento no backend)

# === CONTATO ===
VITE_WHATSAPP_URL=https://wa.me/5521999999999            # Link para WhatsApp (suporte)
VITE_CONTACT_EMAIL=contato@dominio.com                   # Email de contato mostrado na UI

# === OBSOLETAS (não mais usadas diretamente no novo fluxo) ===
# VITE_STRIPE_PAYMENT_LINK_URL=...  → não necessário se criar sessões dinâmicas
# VITE_N8N_WEBHOOK_URL=...          → não necessário se usar backend Supabase para pareamento + envio
