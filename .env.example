# Amo Recorrer Environment Variables

# Stripe Payment Link (required)
VITE_STRIPE_PAYMENT_LINK_URL=https://checkout.stripe.com/c/pay/your-payment-link-here

# n8n Webhook Configuration (required)
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/form-endpoint
VITE_N8N_BASIC_USER=webhook_username
VITE_N8N_BASIC_PASS=webhook_password

# Contact Information (required)
VITE_WHATSAPP_URL=https://wa.me/5511999999999
VITE_CONTACT_EMAIL=suporte@amorecorrer.com.br

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual configuration
# 3. Configure your Stripe payment link to redirect to: https://yourdomain.com/form
# 4. Set up your n8n webhooks to process the form data
# 5. Never commit the actual .env.local file to version control